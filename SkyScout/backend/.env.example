NODE_ENV=development
PORT=4001
LOG_LEVEL=info

DATABASE_URL=postgresql://skyscout:skyscout@localhost:5432/skyscout

JWT_SECRET=dev-insecure-skyscout-jwt-secret-change-me-32+
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

CORS_ORIGIN=*
BODY_LIMIT=100kb

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

CANCELLATION_CUTOFF_HOURS=2
MAX_PASSENGERS_PER_BOOKING=9

SEED_ON_START=false
