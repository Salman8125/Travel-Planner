{
  "name": "roost-frontend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "gen:api": "openapi-typescript ./openapi.json -o src/app/core/api/types.ts",
    "gen:api:live": "openapi-typescript http://localhost:4002/v3/api-docs -o src/app/core/api/types.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/cdk": "^20.2.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@tanstack/angular-query-experimental": "^5.101.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.3",
    "uuid": "^11.0.0",
    "zod": "^3.23.8",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "^9.11.0",
    "@playwright/test": "^1.47.0",
    "@tanstack/angular-query-devtools-experimental": "^5.87.0",
    "@testing-library/angular": "^17.4.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.13",
    "angular-eslint": "^20.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.0",
    "msw": "^2.4.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.61.0"
  }
}
