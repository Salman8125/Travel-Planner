# Roost backend — environment overrides for application.yml (relaxed binding).
SPRING_PROFILES_ACTIVE=prod

# Datasource (server-to-server; use the compose service name inside docker).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/roost
SPRING_DATASOURCE_USERNAME=roost
SPRING_DATASOURCE_PASSWORD=roost

# REQUIRED: HMAC secret for JWT signing (>= 32 chars). The app fails fast if this is empty.
ROOST_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ROOST_JWT_TTL=24h

# Seed an admin + user + 8 hotels with 30 days of inventory on first start.
ROOST_SEED_ENABLED=false

# Per-IP rate limiting (stricter on /api/auth, separate budget for booking writes).
ROOST_RATE_LIMIT_ENABLED=true

# Comma-separated CORS allowlist; empty = allow any origin (dev only).
ROOST_CORS_ORIGINS=
