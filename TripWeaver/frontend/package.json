{
  "name": "tripweaver-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3005",
    "gen:api": "openapi-typescript ./openapi.json -o src/lib/api/types.ts",
    "gen:api:live": "openapi-typescript http://localhost:4005/openapi/v1.json -o src/lib/api/types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@kobalte/core": "^0.13.7",
    "@modular-forms/solid": "^0.25.0",
    "@solidjs/router": "^0.15.1",
    "@tanstack/solid-query": "^5.62.0",
    "@tanstack/solid-table": "^8.20.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "lucide-solid": "^0.460.0",
    "solid-js": "^1.9.3",
    "solid-sonner": "^0.2.8",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tanstack/solid-query-devtools": "^5.62.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-solid": "^0.14.3",
    "jsdom": "^25.0.1",
    "msw": "^2.6.5",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.4.49",
    "prettier": "^3.4.1",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.1.6"
  }
}
