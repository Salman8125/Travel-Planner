DOCKER_GO := docker run --rm -v "$(CURDIR)":/src -w /src -v wv-gomod:/go/pkg/mod -v wv-gobuild:/root/.cache/go-build golang:1.25
SQLC := docker run --rm -v "$(CURDIR)":/src -w /src sqlc/sqlc

.PHONY: tidy build vet test sqlc check itest

tidy:  ; $(DOCKER_GO) go mod tidy
build: ; $(DOCKER_GO) go build ./...
vet:   ; $(DOCKER_GO) go vet ./...
test:  ; $(DOCKER_GO) go test ./...
sqlc:  ; $(SQLC) generate
check: ; $(DOCKER_GO) sh -c "go build ./... && go vet ./... && go test ./..."
itest: ; docker run --rm -v "$(CURDIR)":/src -w /src -v wv-gomod:/go/pkg/mod -v wv-gobuild:/root/.cache/go-build -v /var/run/docker.sock:/var/run/docker.sock -e TESTCONTAINERS_RYUK_DISABLED=true -e TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal golang:1.25 go test -tags=integration ./test/...
