{
  "name": "weathervane-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue",
    "format": "prettier --write .",
    "gen:api": "openapi-typescript ./openapi.yaml -o src/lib/api/types.ts",
    "gen:api:live": "openapi-typescript http://localhost:4004/openapi.yaml -o src/lib/api/types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.101.0",
    "@tanstack/vue-table": "^8.21.0",
    "axios": "^1.7.0",
    "chart.js": "^4.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "lucide-vue-next": "^0.400.0",
    "pinia": "^3.0.0",
    "pinia-plugin-persistedstate": "^4.7.0",
    "reka-ui": "^2.9.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vee-validate": "^4.15.0",
    "@vee-validate/zod": "^4.15.0",
    "vue": "^3.4.38",
    "vue-chartjs": "^5.3.0",
    "vue-router": "^4.4.0",
    "vue-sonner": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/user-event": "^14.5.2",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^20.14.15",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "jsdom": "^24.1.1",
    "msw": "^2.3.5",
    "openapi-typescript": "^7.6.0",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "vue-tsc": "^2.1.0"
  }
}
